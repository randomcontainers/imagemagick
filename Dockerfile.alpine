# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=alpine:3.24

FROM ${BASE_IMAGE} AS build
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
RUN apk add --no-cache \
      aom-dev \
      build-base \
      bzip2-dev \
      cmake \
      dav1d-dev \
      fontconfig-dev \
      freetype-dev \
      lcms2-dev \
      libjpeg-turbo-dev \
      libjxl-dev \
      libpng-dev \
      libraw-dev \
      libtool \
      libwebp-dev \
      libxml2-dev \
      openjpeg-dev \
      pkgconf \
      scanelf \
      tiff-dev \
      xz \
      xz-dev \
      zlib-dev \
      zstd-dev
ARG JOBS

# Alpine's libde265 lacks upstream security fixes, and its libheif decodes
# HEIC through a plugin that depends on it, so both libraries are compiled
# from their upstream releases. They are installed twice: into /usr/local for
# the ImageMagick build and into /out for the image.
ARG LIBDE265_VERSION
ARG LIBDE265_SHA256
ADD --checksum=sha256:${LIBDE265_SHA256} https://github.com/strukturag/libde265/releases/download/v${LIBDE265_VERSION}/libde265-${LIBDE265_VERSION}.tar.gz /src/libde265.tar.gz
WORKDIR /src/libde265
RUN set -eu; \
    tar -xzf /src/libde265.tar.gz --strip-components=1; \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DENABLE_DECODER=OFF \
      -DENABLE_SDL=OFF; \
    cmake --build build -j"${JOBS:-$(nproc)}"; \
    cmake --install build --strip; \
    DESTDIR=/out cmake --install build --strip

ARG LIBHEIF_VERSION
ARG LIBHEIF_SHA256
ADD --checksum=sha256:${LIBHEIF_SHA256} https://github.com/strukturag/libheif/releases/download/v${LIBHEIF_VERSION}/libheif-${LIBHEIF_VERSION}.tar.gz /src/libheif.tar.gz
WORKDIR /src/libheif
# The codecs are compiled into libheif instead of being loaded as plugins, so
# the runtime-deps scan below finds aom and dav1d. musl searches /usr/local/lib
# before /usr/lib, so no RUNPATH is needed to prefer these libraries over the
# Alpine packages.
RUN set -eu; \
    tar -xzf /src/libheif.tar.gz --strip-components=1; \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DENABLE_PLUGIN_LOADING=OFF \
      -DWITH_LIBDE265=ON \
      -DWITH_DAV1D=ON \
      -DWITH_AOM_ENCODER=ON \
      -DWITH_AOM_DECODER=OFF \
      -DWITH_OpenH264_DECODER=OFF \
      -DWITH_X264=OFF \
      -DWITH_X265=OFF \
      -DWITH_EXAMPLES=OFF \
      -DWITH_GDK_PIXBUF=OFF \
      -DBUILD_DOCUMENTATION=OFF \
      -DBUILD_TESTING=OFF; \
    cmake --build build -j"${JOBS:-$(nproc)}"; \
    cmake --install build --strip; \
    DESTDIR=/out cmake --install build --strip; \
    scanelf --needed --nobanner --format '%n#p' /usr/local/lib/libheif.so.1 | tr ',' '\n' > /tmp/libheif-needed; \
    for lib in libde265.so.0 libaom.so libdav1d.so libsharpyuv.so; do \
      grep -Fq "$lib" /tmp/libheif-needed || { cat /tmp/libheif-needed >&2; echo "libheif does not link $lib" >&2; exit 1; }; \
    done

ARG VERSION
ARG SOURCE_SHA256
ADD --checksum=sha256:${SOURCE_SHA256} https://github.com/ImageMagick/ImageMagick/releases/download/${VERSION}/ImageMagick-${VERSION}.tar.xz /src/
WORKDIR /src/ImageMagick
# type-dejavu.xml.in replaces the upstream copy, whose entries point at
# font files that do not exist. --without-gcc-arch stops configure from
# tuning the build for the runner's CPU model.
RUN --mount=type=bind,source=type-dejavu.xml.in,target=/tmp/type-dejavu.xml.in \
    set -eu; \
    tar -xJf "/src/ImageMagick-${VERSION}.tar.xz" --strip-components=1; \
    cp /tmp/type-dejavu.xml.in config/type-dejavu.xml.in; \
    ./configure \
      --prefix=/usr/local \
      --disable-dependency-tracking \
      --disable-static \
      --disable-docs \
      --enable-hdri \
      --with-quantum-depth=16 \
      --with-modules \
      --with-security-policy=open \
      --with-dejavu-font-dir=/usr/share/fonts/dejavu \
      --without-frozenpaths \
      --without-gcc-arch \
      --without-gslib \
      --without-magick-plus-plus \
      --without-perl \
      --without-x \
      --with-bzlib \
      --with-fontconfig \
      --with-freetype \
      --with-heic \
      --with-jpeg \
      --with-jxl \
      --with-lcms \
      --with-lzma \
      --with-openjp2 \
      --with-png \
      --with-raw \
      --with-tiff \
      --with-webp \
      --with-xml \
      --with-zlib \
      --with-zstd; \
    make -j"${JOBS:-$(nproc)}"; \
    make install-strip DESTDIR=/out; \
    rm -rf /out/usr/local/include /out/usr/local/lib/cmake /out/usr/local/lib/pkgconfig /out/usr/local/share/doc /out/usr/local/share/man; \
    rm -f /out/usr/local/bin/*-config /out/usr/local/lib/*.la
COPY --link policy.xml /out/usr/local/etc/ImageMagick-7/policy.xml

ARG BASE_IMAGE
# configure drops a delegate without failing when its library is missing, so
# the delegate list is checked here. runtime-deps lists the so: names the
# binaries and coder modules need, minus the libraries built here, plus the
# packages in runtime-deps.alpine.
RUN --mount=type=bind,source=runtime-deps.alpine,target=/tmp/runtime-deps.extra \
    set -eu; \
    meta=/out/usr/local/share/randomcontainers/imagemagick; \
    mkdir -p "$meta/licenses"; \
    cp LICENSE NOTICE "$meta/licenses/"; \
    cp /src/libde265/COPYING "$meta/licenses/COPYING.libde265"; \
    cp /src/libheif/COPYING "$meta/licenses/COPYING.libheif"; \
    echo "${VERSION}" > "$meta/version"; \
    printf '%s\n' \
      "https://github.com/ImageMagick/ImageMagick/releases/download/${VERSION}/ImageMagick-${VERSION}.tar.xz" \
      "https://github.com/strukturag/libde265/releases/download/v${LIBDE265_VERSION}/libde265-${LIBDE265_VERSION}.tar.gz" \
      "https://github.com/strukturag/libheif/releases/download/v${LIBHEIF_VERSION}/libheif-${LIBHEIF_VERSION}.tar.gz" \
      "https://github.com/randomcontainers/imagemagick/releases/tag/v${VERSION}" \
      > "$meta/source"; \
    LD_LIBRARY_PATH=/out/usr/local/lib /out/usr/local/bin/magick -version > /tmp/magick-version; \
    grep -q "^Version: ImageMagick ${VERSION} Q16-HDRI " /tmp/magick-version; \
    missing=; \
    for f in HDRI Modules OpenMP; do \
      grep '^Features:' /tmp/magick-version | grep -qw "$f" || missing="$missing $f"; \
    done; \
    for d in bzlib fontconfig freetype heic jng jp2 jpeg jxl lcms ltdl lzma png raw tiff webp xml zlib zstd; do \
      grep '^Delegates' /tmp/magick-version | grep -qw "$d" || missing="$missing $d"; \
    done; \
    if [ -n "$missing" ]; then cat /tmp/magick-version >&2; echo "missing:$missing" >&2; exit 1; fi; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "compiler: $(cc --version | head -n 1)"; \
      echo "libde265: ${LIBDE265_VERSION}"; \
      echo "libheif: ${LIBHEIF_VERSION}"; \
      sed -n 's/^  \$ \(\.\/configure .*\)/\1/p' config.log; \
      cat /tmp/magick-version; \
    } > "$meta/buildinfo"; \
    scanelf --needed --nobanner --format '%n#p' --recursive /out/usr/local | tr ',' '\n' | sort -u > /tmp/needed; \
    while read -r so; do \
      if [ -n "$so" ] && [ -z "$(find /out -name "$so" -print -quit)" ]; then echo "so:$so"; fi; \
    done < /tmp/needed > /tmp/elf-deps; \
    test -s /tmp/elf-deps; \
    sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
COPY --link --from=build /out/usr/local/ /usr/local/
RUN set -eu; \
    xargs apk add --no-cache ca-certificates tini < /usr/local/share/randomcontainers/imagemagick/runtime-deps; \
    fc-cache -f; \
    addgroup -g 1000 app; \
    adduser -D -u 1000 -G app app; \
    install -d -m 1777 /work /cache
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "magick"]
CMD ["-version"]
